# ─────────────────────────────────────────
# BusLanka — Environment Variables Example
# Copy to .env and fill in real values.
# Never commit .env to version control.
# ─────────────────────────────────────────

# ── Node ──────────────────────────────────
NODE_ENV=development

# ── Database (PostgreSQL + PostGIS) ───────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=buslanka_dev
DATABASE_USER=buslanka
DATABASE_PASSWORD=changeme_dev
DATABASE_SSL=false
DATABASE_POOL_SIZE=10

# ── Redis ─────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT ───────────────────────────────────
# Generate with: openssl genrsa -out jwt-private.pem 2048
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem
JWT_ACCESS_EXPIRES_IN=900        # 15 minutes in seconds
JWT_REFRESH_EXPIRES_IN=604800    # 7 days in seconds

# QR ticket signing key (separate from JWT)
QR_PRIVATE_KEY_PATH=./secrets/qr-private.pem
QR_PUBLIC_KEY_PATH=./secrets/qr-public.pem

# ── API ───────────────────────────────────
API_PORT=3001
API_BASE_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003

# ── Web Apps ──────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3001/v1/ws
NEXT_PUBLIC_MAP_PROVIDER=mapbox
NEXT_PUBLIC_MAP_TOKEN=pk.your_mapbox_token_here

# ── SMS / OTP ─────────────────────────────
SMS_PROVIDER=dialog          # dialog | mobitel | twilio
SMS_API_KEY=your_sms_api_key
SMS_FROM=BusLanka
OTP_EXPIRES_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ── Email ─────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@buslanka.lk
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM="BusLanka <noreply@buslanka.lk>"

# ── Object Storage (S3-compatible) ────────
STORAGE_PROVIDER=minio       # minio | s3 | wasabi
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=buslanka-dev
STORAGE_REGION=ap-southeast-1
STORAGE_PUBLIC_URL=http://localhost:9000/buslanka-dev

# ── Payment Gateway ───────────────────────
PAYMENT_PROVIDER=payhere     # payhere | stripe
PAYMENT_MERCHANT_ID=your_merchant_id
PAYMENT_MERCHANT_SECRET=your_merchant_secret
PAYMENT_SANDBOX=true
PAYMENT_WEBHOOK_SECRET=your_webhook_hmac_secret

# ── Push Notifications (Firebase) ─────────
FCM_PROJECT_ID=your_firebase_project_id
FCM_PRIVATE_KEY_PATH=./secrets/firebase-adminsdk.json

# ── Rate Limiting ─────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_UNAUTHENTICATED=60
RATE_LIMIT_MAX_PASSENGER=300
RATE_LIMIT_MAX_OPERATOR_GPS=600

# ── Monitoring ────────────────────────────
SENTRY_DSN=
LOG_LEVEL=debug              # debug | info | warn | error

# ── Booking ───────────────────────────────
BOOKING_HOLD_MINUTES=10
BOOKING_REFERENCE_PREFIX=BL
